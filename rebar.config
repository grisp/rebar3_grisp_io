{erl_opts, [debug_info]}.

{deps, [
    hackney,
    jsx
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        no_unknown
    ]}
]}.

{plugins, [
    {rebar3_grisp, "~> 2.8"},
    {rebar3_ex_doc, "~> 0.3"}
]}.

{profiles, [
    {test, [
        {deps, [
            meck
        ]}
    ]}
]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {extras, [
          {"CHANGELOG.md", #{title => "Changelog"}},
          {"README.md", #{title => "Overview"}},
          {"LICENSE.md", #{title => "License"}}
    ]},
    {main, "README.md"},
    {homepage_url, "https://github.com/grisp/rebar3_grisp_io"},
    {source_url, "https://github.com/grisp/rebar3_grisp_io"}
]}.
